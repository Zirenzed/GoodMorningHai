    makeScratch(wrap, canvas, 0.8, function () { var hint = view.querySelector('.scratch-hint'); if (hint) hint.remove(); confettiBurst(); var line = el('p', 'final-line', 'รับเป็นแฟนกาแฟคู่ใจผม 1 วันได้ไหมครับเบบี๋ 🖤'); view.appendChild(line); requestAnimationFrame(function () { line.classList.add('show'); }); });
  }
  var PAGES = { play: startCafe, hunt: renderHunt, gift: renderGift, letter: renderLetter, score: renderScore, final: renderFinal };
